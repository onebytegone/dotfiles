# > serverless Aliases

function slsDeployAndTail {
   FUNCTION_NAME=$1
   EXTRA_PARAMS=${@:2}
   sls deploy function -f "${FUNCTION_NAME}" $EXTRA_PARAMS \
      && sls logs -f "${FUNCTION_NAME}" -t $EXTRA_PARAMS
}

# `_amux_send_initial_prompt` >> Wait for conch boot, then type+submit a prompt in the target pane

_amux_send_initial_prompt() {
   local TARGET="${1}:${2}"
   local PROMPT="${3}"
   local MARKER="${AMUX_PROMPT_READY_MARKER:-Initializing firewall...}"
   local SETTLE="${AMUX_PROMPT_SETTLE_SECONDS:-5}"
   local DEADLINE=$(( $(date +%s) + 300 ))

   while [ "$(date +%s)" -lt "${DEADLINE}" ]; do
      if tmux capture-pane -p -t "${TARGET}" | grep -qF -- "${MARKER}"; then
         sleep "${SETTLE}"
         tmux send-keys -t "${TARGET}" -l -- "${PROMPT}"
         tmux send-keys -t "${TARGET}" Enter
         return 0
      fi
      sleep 0.25
   done
}

# `amux [-p PROMPT] [-- CONCH_ARGS...]` >> Launch or reattach a tmux dev session with two side-by-side panes

function amux {
   local PROMPT=""
   local CONCH_ARGS=()

   while [ $# -gt 0 ]; do
      case "$1" in
         -p)
            PROMPT="$2"
            shift 2
            ;;
         --)
            shift
            CONCH_ARGS=("$@")
            break
            ;;
         *)
            echo "Usage: amux [-p PROMPT] [-- CONCH_ARGS...]" >&2
            return 1
            ;;
      esac
   done

   local DIR_NAME=$(basename "$(pwd)")
   local DIR_HASH=$(echo -n "$(pwd)" | md5 | head -c 4)
   local SESSION_NAME="${DIR_NAME}-${DIR_HASH}"

   if tmux has-session -t "${SESSION_NAME}" 2>/dev/null; then
      if [ -n "${PROMPT}" ]; then
         echo "amux: session '${SESSION_NAME}' already exists; refusing to send -p prompt to a running conch" >&2
         return 1
      fi
      if [ -n "${TMUX}" ]; then
         tmux switch-client -t "${SESSION_NAME}"
      else
         tmux attach-session -t "${SESSION_NAME}"
      fi
      return 0
   fi

   tmux new-session -d -s "${SESSION_NAME}" -c "$(pwd)"
   tmux split-window -h -t "${SESSION_NAME}" -c "$(pwd)"
   tmux send-keys -t "${SESSION_NAME}:0.0" "conch run ${CONCH_ARGS[*]}" C-m
   tmux select-pane -t "${SESSION_NAME}:0.0"

   if [ -n "${PROMPT}" ]; then
      _amux_send_initial_prompt "${SESSION_NAME}" "0.0" "${PROMPT}" &
   fi

   if [ -n "${TMUX}" ]; then
      tmux switch-client -t "${SESSION_NAME}"
   else
      tmux attach-session -t "${SESSION_NAME}"
   fi
}

# `amux-tree <branch> [-p PROMPT] [-- CONCH_ARGS...]` >> Create a worktree and launch a tmux session with conch + (vim GOAL.md or auto-prompt)

function amux-tree {
   local BRANCH="${1%/}"

   if [ -z "${BRANCH}" ]; then
      echo "Usage: amux-tree <branch-name> [-p PROMPT] [-- CONCH_ARGS...]" >&2
      return 1
   fi
   shift

   local PROMPT=""
   local CONCH_ARGS=()

   while [ $# -gt 0 ]; do
      case "$1" in
         -p)
            PROMPT="$2"
            shift 2
            ;;
         --)
            shift
            CONCH_ARGS=("$@")
            break
            ;;
         *)
            echo "Usage: amux-tree <branch-name> [-p PROMPT] [-- CONCH_ARGS...]" >&2
            return 1
            ;;
      esac
   done

   "${source_dir}/scripts/worktree.sh" "${BRANCH}" >/dev/null

   local PARENT_DIR=$("${source_dir}/scripts/find-worktree-root.sh")
   local FOLDER_NAME="${BRANCH//\//_}"
   local WORKTREE_PATH="${PARENT_DIR}/${FOLDER_NAME}"
   local SYNC_LOG="${WORKTREE_PATH}/.worktree-sync.log"

   local DIR_NAME=$(basename "${WORKTREE_PATH}")
   local DIR_HASH=$(echo -n "${WORKTREE_PATH}" | md5 | head -c 4)
   local SESSION_NAME="${DIR_NAME}-${DIR_HASH}"

   if tmux has-session -t "${SESSION_NAME}" 2>/dev/null && [ -n "${PROMPT}" ]; then
      echo "amux-tree: session '${SESSION_NAME}' already exists; refusing to send -p prompt to a running conch" >&2
      return 1
   fi

   tmux new-session -d -s "${SESSION_NAME}" -c "${WORKTREE_PATH}"
   tmux split-window -h -t "${SESSION_NAME}" -c "${WORKTREE_PATH}"
   tmux send-keys -t "${SESSION_NAME}:0.0" "conch run ${CONCH_ARGS[*]}" C-m

   if [ -n "${PROMPT}" ]; then
      tmux send-keys -t "${SESSION_NAME}:0.1" "cat \"${SYNC_LOG}\"" C-m
      tmux select-pane -t "${SESSION_NAME}:0.0"
      _amux_send_initial_prompt "${SESSION_NAME}" "0.0" "${PROMPT}" &
   else
      tmux send-keys -t "${SESSION_NAME}:0.1" "vim GOAL.md && cat \"${SYNC_LOG}\"" C-m
      tmux select-pane -t "${SESSION_NAME}:0.1"
   fi

   if [ -n "${TMUX}" ]; then
      tmux switch-client -t "${SESSION_NAME}"
   else
      tmux attach-session -t "${SESSION_NAME}"
   fi
}

# `speak <file>` >> Read a file aloud using macOS text-to-speech

function speak {
   cat "$1" | say -r 400 -i
}

# `placeholder-video <file>` >> Generate a 10s 720p test video with a 1kHz beep each second

function placeholder-video {
   ffmpeg -f lavfi -i testsrc=duration=10:size=1280x720:rate=30 -f lavfi -i sine=frequency=1000:duration=10 -vf "showinfo,drawtext=text='$1':fontcolor=white:fontsize=48:box=1:boxcolor=black@0.5:boxborderw=10:x=(w-text_w)/2:y=h-th-40" -af "volume='if(lt(mod(t,1),0.1),1,0)':eval=frame" -c:v libx264 -pix_fmt yuv420p -c:a aac "$1"
}

