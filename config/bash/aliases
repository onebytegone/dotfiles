# `gds [ref]` >> git diff --stat against the merge base of `ref` (default branch if omitted)
function gds {
   BASE_REF="${1}"
   if [ -z "${BASE_REF}" ]; then
      BASE_REF="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null || echo origin/master)"
   fi
   git diff --stat "$(git merge-base HEAD "${BASE_REF}")"
}

# `gd [ref]` >> git diff against the merge base of `ref` (default branch if omitted)
function gd {
   BASE_REF="${1}"
   if [ -z "${BASE_REF}" ]; then
      BASE_REF="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null || echo origin/master)"
   fi
   git diff "$(git merge-base HEAD "${BASE_REF}")"
}

function proxy_git {
   if [ $1 = "ub" ]; then
      # Add "username branch", i.e. `git ub branch-name` -> `git checkout -b $(whoami)/branch-name`
      \git checkout -b "$(whoami)/${2}" ${@:3}
   elif [ $1 = "dnm" ]; then
      # Add "do not merge" shortcut, i.e. `git dnm [message]`
      COMMIT_MESSAGE='DO NOT MERGE'
      if [ -n "${2}" ]; then
         COMMIT_MESSAGE="${COMMIT_MESSAGE}: ${2}"
      fi
      \git commit -a -m "${COMMIT_MESSAGE}"
   else
      \git "$@"
   fi
}

alias git="proxy_git"

function delete_merged_branches {
   UPSTREAM_BRANCH=$1
   if [ -z "${UPSTREAM_BRANCH}" ]; then
      echo "ERROR an upstream branch must be supplied. e.g. delete_merged_branches 'master'"
      return
   fi

   echo "Finding branches merged into ${UPSTREAM_BRANCH}"
   for BRANCH in $(git branch --merged ${UPSTREAM_BRANCH} | grep -v "\*\|${UPSTREAM_BRANCH}"); do
      git log -n 1 "${BRANCH}"
      while true; do
         read -p "Delete ${BRANCH}? " yn
         case $yn in
            [Yy]*)
               git branch -d "${BRANCH}"
               break
               ;;
            [Nn]*)
               break
               ;;
            *)
               echo "Please answer yes or no"
               ;;
         esac
      done
   done
}

