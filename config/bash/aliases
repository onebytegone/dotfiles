# `ttlrepo` >> Set window title to name of current repo

ttlrepo() {
   REPO_NAME=$(basename "$(git rev-parse --show-toplevel)")
   echo -e "\033k${REPO_NAME}\033\\"
}

# `mark` >> Print a multiline delimiter with the current time

alias mark="printf '=%.0s' {0..80} && echo && printf '=%.0s' {0..80} && echo && date +'%Y-%m-%d %H:%M:%S' && printf '=%.0s' {0..80} && echo && printf '=%.0s' {0..80} && echo"

# `lowercase` >> Convert stdin to lowercase

alias lowercase="tr '[:upper:]' '[:lower:]'"

# `uppercase` >> Convert stdin to uppercase

alias uppercase="tr '[:lower:]' '[:upper:]'"

# `bell` >> Play a terminal bell 5 times

alias bell='for I in $(seq 1 5); do printf "\a"; sleep 0.4; done'

# `pbenv <NAME>` >> Export pasteboard contents to an environment variable

pbenv() {
   VALUE=$(pbpaste)
   echo -e "\033[1;30m$1=${VALUE//?/*} ($(echo -n "${VALUE}" | wc -c) chars)\033[0m"
   export "$1"="$(pbpaste)"
}

